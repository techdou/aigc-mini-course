# ============================================================
# AIGC Mini Course · .gitignore
# 原则：私密信息与 API 密钥不泄露；开发软件配置目录不上传；
#       构建产物与本地缓存不入库；截图等临时产物不污染仓库历史。
# ============================================================

# ---------- Node.js 依赖与构建缓存 ----------
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.yarn/
.pnpm-store/

# ---------- 本地构建产物（HTML 由 build.js 重新生成，不入库） ----------
# 注意：index.html 与 lesson-XX.html 是站点本身，必须入库（GitHub Pages 直接托管）。
# 这里只忽略可重生成的中间文件。
*.log
.cache/
dist/
build-output/

# ---------- 截图与本地验证产物（临时文件，不污染仓库历史） ----------
_shots/
screenshots/
*.screenshot.png

# ---------- 环境变量与密钥（最高优先级，绝不泄露） ----------
.env
.env.local
.env.*.local
.env.development
.env.production
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json
service-account*.json

# API 密钥常见命名模式（兜底，精确匹配避免误伤合法文件）
# 只匹配点号开头的环境配置文件，不匹配普通文件名中的 token/secret 字样
.env.*
*.api-key
*.apikey
*.pem.key
config/secrets.*
# 示例模板文件保留
!**/*.example
!.env.example

# ---------- 编辑器与 IDE 配置（开发软件配置目录不上传） ----------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
*.sublime-workspace
*.sublime-project
.history/
.fleet/

# ---------- 操作系统生成的杂项文件 ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- 临时文件与备份 ----------
*.tmp
*.temp
*.bak
*.old
*.orig
~$*

# ---------- 原始大体积资料包（属于本地资产，不属于本仓库） ----------
*.zip
*.7z
*.rar
*.tar.gz
*.iso
# SHA256 校验文件如果对应的是被忽略的 zip，也一起忽略
*.sha256

# ---------- 设计软件源文件（设计稿原始文件，按需单独管理） ----------
*.psd
*.ai
*.sketch
*.fig
*.xd

# ---------- 本地数据库与缓存 ----------
*.sqlite
*.sqlite3
*.db
.redis/
